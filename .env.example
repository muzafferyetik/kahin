# Kopyala: .env  (docker compose ve backend okur)
POSTGRES_USER=kahin
POSTGRES_PASSWORD=kahin
POSTGRES_DB=kahin
POSTGRES_PORT=5433
REDIS_PORT=6380
API_PORT=8001

DATABASE_URL=postgresql+asyncpg://kahin:kahin@localhost:5433/kahin
TEST_DATABASE_URL=postgresql+asyncpg://kahin:kahin@localhost:5433/kahin_test
REDIS_URL=redis://localhost:6380/0

# Üretimde mutlaka değiştir!
JWT_SECRET=change-me-in-production-kahin-secret-32chars-min
CORS_ORIGINS=["http://localhost:3000"]
