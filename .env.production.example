# =============================================================================
# KAHİN — Üretim Ortamı Çevre Değişkenleri Şablonu (.env.production)
# =============================================================================

# 1. Alan Adı & SSL (Caddy Otomatik SSL için)
DOMAIN=kahin.seninalanadin.com

# 2. PostgreSQL Veritabanı
POSTGRES_USER=kahin
POSTGRES_PASSWORD=cok_guclu_rastgele_bir_sifre_giriniz_123!
POSTGRES_DB=kahin

# 3. Güvenlik & Token (Terminalde: openssl rand -hex 32)
JWT_SECRET=en_az_32_karakter_uzunlugunda_guvenli_rastgele_anahtar_buraya
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 4. CORS Politikası (Ön yüzün alan adını virgülle ekleyin)
CORS_ORIGINS=https://kahin.seninalanadin.com,https://kahin.vercel.app

# 5. Ön Yüz API ve WebSocket Uç Noktaları (Kullanıcı Tarayıcısının Erişeceği URL'ler)
NEXT_PUBLIC_API_URL=https://kahin.seninalanadin.com/api/v1
NEXT_PUBLIC_WS_URL=wss://kahin.seninalanadin.com/ws/markets

# 6. Performans & Worker Sayısı (Sunucunuzun CPU çekirdeğine göre ayarlayın)
WEB_CONCURRENCY=2
